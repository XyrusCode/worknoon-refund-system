# ==============================================================================
# WORKNOON Refund System - Environment Variables Template
# Copy this file to .env before running locally or via docker-compose
# ==============================================================================

# Database Connection (Neon PostgreSQL or Local Docker)
# For local Docker Compose, defaults to postgresql://worknoon:worknoon_dev@db:5432/worknoon_refund?sslmode=disable
DATABASE_URL="postgresql://worknoon:worknoon_dev@localhost:5432/worknoon_refund"

# AI Integration (Google Gemini 2.5 Flash via Vercel AI SDK)
# Obtain from https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY="your-google-gemini-api-key-here"

# Backend Configuration
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Frontend Configuration
VITE_API_URL="http://localhost:3001/api"
